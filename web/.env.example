# BullCapital Web — Environment Variables
# Copy this file to .env.local and fill in your values
#
# Supabase URLs — encontre em: Project Settings > Database > Connection string
#
# DATABASE_URL  → Transaction pooler (porta 6543) — usado em runtime pelo Prisma
#   Formato: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# DIRECT_URL    → Direct connection (porta 5432) — usado apenas para migrations
#   Formato: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# NextAuth — gere um secret com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://seu-app.vercel.app

# OpenRouter — usado para análises com deepseek
OPENROUTER_API_KEY=

# URL da API FastAPI hospedada no Railway
ANALYSIS_API_URL=https://seu-api.railway.app/api/v1

# Segredo compartilhado com o Railway para chamadas server-to-server
# Gere um valor forte e use o mesmo API_SHARED_SECRET no web e na API
API_SHARED_SECRET=
