# BullCapital Web — Environment Variables
# Copy this file to .env.local and fill in your values
#
# Neon (Postgres único do plano — docs/migracao-arquitetura.md D6)
#
# DATABASE_URL  → connection string POOLED do Neon — usada em runtime pelo Prisma
#   Formato: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[db]?sslmode=require
#
# DIRECT_URL    → connection string direta (sem -pooler) — usada apenas para migrations
#   Formato: postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[db]?sslmode=require

DATABASE_URL=postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[db]?sslmode=require
DIRECT_URL=postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[db]?sslmode=require

# NextAuth — gere um secret com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://seu-app.vercel.app

# OpenRouter — usado para análises com deepseek
OPENROUTER_API_KEY=

# URL da API do AI Service (repo bullcapital-ai; host é escolha do time de IA)
ANALYSIS_API_URL=https://ai.exemplo.com/api/v1

# URL pública do AI Service para o SSE direto do browser (ADR 0008)
NEXT_PUBLIC_ORCHESTRATOR_URL=https://ai.exemplo.com

# Segredo compartilhado com o AI Service: chamadas server-to-server e
# assinatura do token curto de stream (a IA valida com o mesmo valor)
API_SHARED_SECRET=

# Brapi PRO — usado pela ingestão de mercado (modules/market/ingest)
BRAPI_KEY=

# Protege os route handlers de cron (/api/cron/*); o Vercel Cron envia
# automaticamente Authorization: Bearer $CRON_SECRET quando definido
CRON_SECRET=

# Upstash Redis — F4 da migração: rate-limit, locks e cache quente
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — export EOD opcional do último snapshot bom (ADR 0007)
BLOB_READ_WRITE_TOKEN=
