# BullCapital — Web Environment Variables
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# App base URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL connection string (standard pg driver format)
# Matches docker-compose db service: user=bullcapital pass=bullcapital db=bullcapital
DATABASE_URL=postgresql://bullcapital:bullcapital@localhost:5432/bullcapital

# Brapi API key for Brazilian market data — optional for local dev
# Get yours at https://brapi.dev
BRAPI_KEY=
