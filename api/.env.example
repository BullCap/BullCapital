# BullCapital AI Service — Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string (asyncpg driver format required by SQLAlchemy async)
# Matches docker-compose db service: user=bullcapital pass=bullcapital db=bullcapital port=5432
# Note: when running inside Docker network use host "db"; from host machine use "localhost"
DATABASE_URL=postgresql+asyncpg://bullcapital:bullcapital@localhost:5432/bullcapital
DATABASE_SSL=false

# OpenAI API key — required for the InvestmentAgent (gpt-4o)
OPENAI_API_KEY=sk-

# OpenRouter API key — preferred for deepseek-v4-flash
OPENROUTER_API_KEY=sk-
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Allowed CORS origins — must include the Next.js app origin
CORS_ORIGINS=http://localhost:3000

# Optional
LOG_LEVEL=INFO
