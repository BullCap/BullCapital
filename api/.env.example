# BullCapital AI Service — Environment Variables
# Copy this file to .env and fill in your values

# ─── Local development ────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://bullcapital:bullcapital@localhost:5432/bullcapital
# DATABASE_SSL=false
# CORS_ORIGINS=http://localhost:3000

# ─── Produção (Supabase) ──────────────────────────────────────────────────────
# A API usa conexão direta (porta 5432), não o pooler — asyncpg não é compatível
# com PgBouncer em transaction mode.
# Formato: postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_SSL=true

# OpenAI API key — usado como fallback para gpt-4o
OPENAI_API_KEY=sk-

# OpenRouter API key — preferido para deepseek-v4-flash
OPENROUTER_API_KEY=sk-
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Allowed CORS origins — deve incluir a origem do app Vercel
# Múltiplas origens separadas por vírgula: https://bullcapital.vercel.app,http://localhost:3000
CORS_ORIGINS=https://seu-app.vercel.app

# Optional
LOG_LEVEL=INFO
